<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.finos.legend.engine</groupId>
        <artifactId>legend-engine-core-emit</artifactId>
        <version>4.129.6-SNAPSHOT</version>
    </parent>

    <artifactId>legend-engine-emit-rust</artifactId>
    <name>Legend Engine - Testing - EMIT Rust Parity Harness</name>
    <description>
        Drives EMIT models through both the Java engine (legend-engine-emit's
        EMITRunner) and the Rust engine (loaded via the liblegend_engine_jni
        cdylib produced by `cargo build -p legend-engine-rust-jni` in the
        legend-engine-rust workspace) and reports per-phase parity. Initial
        Rust coverage is one merged PARSE_AND_COMPILE cell, compared against
        the conjunction of Java's PARSE and COMPILE phases; later phases are
        scaffolded as UNSUPPORTED so the diff matrix is complete from day one.
        Skips Rust-side tests cleanly when the cdylib is not built — default
        `mvn install` does NOT require cargo on PATH.
    </description>

    <properties>
        <!--
            Absolute path to the engine cdylib produced by:
              cd legend-engine-rust && cargo build -p legend-engine-rust-jni
            The os-* profiles below pick the right file extension per OS.
            At test time, surefire passes this path as -Dlegend.engine.cdylib.path
            so the local PureRustEvaluator stub class (declared in this module)
            can System.load it explicitly. If the file does not exist, tests
            short-circuit via JUnit Assumptions and report Skipped rather
            than Failed — so this default `mvn install` still works even
            with no cargo on PATH.
        -->
        <legend.cdylib.ext></legend.cdylib.ext>
        <legend.engine.cdylib.path>${project.basedir}/../../../legend-engine-rust/target/debug/liblegend_engine_jni${legend.cdylib.ext}</legend.engine.cdylib.path>
        <!--
            Workspace classpath TOML (~142 repos: 8 platform + ~134 engine).
            Generated by `cd legend-engine-rust && cargo gen-classpath`.
            EMITRustBridge reads this and rewrites the descriptor paths to
            absolute when synthesizing a per-model classpath. If the file
            is missing, isAvailable() returns false and tests skip.
        -->
        <legend.pure.classpath>${project.basedir}/../../../legend-engine-rust/legend-pure-classpath.toml</legend.pure.classpath>
    </properties>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.dylib</legend.cdylib.ext>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.so</legend.cdylib.ext>
            </properties>
        </profile>
        <profile>
            <id>os-win</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <legend.cdylib.ext>.dll</legend.cdylib.ext>
            </properties>
        </profile>
    </profiles>

    <dependencies>
        <!-- EMIT framework — pulls protocol, compiler, grammar, jackson-yaml,
             test-runners and all transitive deps we need to drive the Java side. -->
        <dependency>
            <groupId>org.finos.legend.engine</groupId>
            <artifactId>legend-engine-emit</artifactId>
        </dependency>

        <!-- ECLIPSE COLLECTIONS -->
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.collections</groupId>
            <artifactId>eclipse-collections</artifactId>
        </dependency>
        <!-- ECLIPSE COLLECTIONS -->

        <!-- JUNIT 5 (compile scope: this module ships a @TestFactory builder
             as part of its main API, just like legend-engine-emit-junit) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>

        <!-- TEST -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- TEST -->
    </dependencies>

    <build>
        <plugins>
            <!--
                Surefire: pass the cdylib path as a system property the
                local PureRustEvaluator stub reads in its static block.
                If the file does not exist there at test time, tests
                Assumption-skip cleanly.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <legend.engine.cdylib.path>${legend.engine.cdylib.path}</legend.engine.cdylib.path>
                        <legend.pure.classpath>${legend.pure.classpath}</legend.pure.classpath>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
